{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joevingracien-com",
  "compatibility_date": "2025-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "limits": {
    "cpu_ms": 50000
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}

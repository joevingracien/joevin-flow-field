# Environment Variables
# Copy this file to .env for local development

# ===========================================
# Cloudflare (Optional)
# ===========================================
# These are only needed if using Cloudflare services beyond Workers

# Cloudflare Account ID (found in dashboard URL or API)
# CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API Token (create at https://dash.cloudflare.com/profile/api-tokens)
# CLOUDFLARE_API_TOKEN=

# ===========================================
# Application (Optional)
# ===========================================
# Add your application-specific environment variables below

# Example:
# API_URL=https://api.example.com
# DEBUG=false
